{
  "name": "leadmagic-mcp-server",
  "version": "1.1.0",
  "description": "Local stdio MCP server for the LeadMagic public enrichment API.",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "leadmagic",
    "b2b",
    "data-enrichment",
    "email-finder",
    "lead-generation",
    "company-data",
    "profile-enrichment",
    "claude",
    "cursor",
    "windsurf",
    "continue",
    "ai-tools",
    "typescript",
    "production-ready",
    "zero-config",
    "enterprise",
    "api-client",
    "nodejs",
    "sdk",
    "automation",
    "prospecting",
    "sales-intelligence",
    "b2b-data",
    "email-validation",
    "company-intelligence"
  ],
  "author": {
    "name": "LeadMagic Team",
    "email": "support@leadmagic.io",
    "url": "https://leadmagic.io"
  },
  "license": "MIT",
  "homepage": "https://github.com/LeadMagic/leadmagic-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeadMagic/leadmagic-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/LeadMagic/leadmagic-mcp/issues",
    "email": "support@leadmagic.io"
  },
  "main": "dist/index.js",
  "bin": {
    "leadmagic-mcp-server": "dist/index.js",
    "leadmagic-mcp-install": "dist/install.js"
  },
  "files": [
    "dist/",
    ".env.example",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsx watch src/index.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run validate",
    "inspector": "npx @modelcontextprotocol/inspector",
    "validate": "npm run type-check && npm run build && echo '\u2705 Validation passed'",
    "install-interactive": "tsx src/install.tsx",
    "quick-setup": "npm install -g leadmagic-mcp-server && leadmagic-mcp-install"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "ink": "6.0.1",
    "ink-link": "4.1.0",
    "ink-spinner": "5.0.0",
    "react": "19.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
